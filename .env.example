# Required
LUBELOGGER_URL=http://lubelogger:8080
LUBELOGGER_API_KEY=

# Bearer token for the MCP endpoint (>= 16 chars). Generate with: openssl rand -hex 24
MCP_AUTH_TOKEN=

# Endpoint path. Without MCP_AUTH_TOKEN the server only starts if this holds a random segment of at
# least 32 characters, which then acts as the credential: /mcp/<output of: openssl rand -hex 16>
MCP_PATH=/mcp

# Auth. token (default) uses MCP_AUTH_TOKEN or a secret MCP_PATH above. homeassistant signs in with a
# Home Assistant admin account: leave MCP_AUTH_TOKEN and MCP_PATH unset and fill in the three required
# below (PUBLIC_URL, HOME_ASSISTANT_PUBLIC_URL, HOME_ASSISTANT_URL). DATA_DIR and ALLOWED_REDIRECT_HOSTS are optional.
# oidc, lubelogger-key and lubelogger-password are planned and refuse to start in this version.
AUTH_MODE=token

# Home Assistant mode (required): this server's public address, no path
PUBLIC_URL=https://mcp.example.com

# Home Assistant mode (required): Home Assistant's address as the browser sees it, no path
HOME_ASSISTANT_PUBLIC_URL=https://ha.example.com

# Home Assistant mode (required): Home Assistant's address as this server reaches it, no path
HOME_ASSISTANT_URL=http://homeassistant:8123

# Home Assistant mode (optional): where oauth.json (registered clients and connections) is kept. Keep private, back up
DATA_DIR=./data

# Home Assistant mode (optional): hostnames a login code may be sent to, no scheme or port; only these can
# register as clients. Add localhost,127.0.0.1 for Claude Code
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# Optional
PORT=3000
HOST=0.0.0.0
CONFIRM_TTL_MINUTES=30
REQUEST_TIMEOUT_MS=15000
