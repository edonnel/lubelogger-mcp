# Required
LUBELOGGER_URL=http://lubelogger:8080

# Required, except when lubelogger-key is the only sign-in method: then everyone uses their own key
LUBELOGGER_API_KEY=

# Bearer token for the MCP endpoint (>= 16 chars). Generate with: openssl rand -hex 24
MCP_AUTH_TOKEN=

# Endpoint path. Without MCP_AUTH_TOKEN the server only starts if this holds a random segment of at
# least 32 characters, which then acts as the credential: /mcp/<output of: openssl rand -hex 16>
MCP_PATH=/mcp

# Sign-in methods, comma-separated: homeassistant, oidc, lubelogger-password and lubelogger-key, any of them.
# homeassistant signs in with a Home Assistant admin account and needs PUBLIC_URL, HOME_ASSISTANT_PUBLIC_URL
# and HOME_ASSISTANT_URL below.
# oidc signs in with an OpenID Connect provider and needs PUBLIC_URL and the OIDC_* settings below.
# Leave MCP_AUTH_TOKEN and MCP_PATH unset. DATA_DIR and ALLOWED_REDIRECT_HOSTS are optional.
# lubelogger-password signs in with a LubeLogger username and password and needs LUBELOGGER_ALLOWED_USERS below.
# lubelogger-key signs in with the person's own LubeLogger API key. LubeLogger's own login must be on for both.
# Never use AUTH_METHODS together with a non-token AUTH_MODE.
# AUTH_METHODS=homeassistant,oidc

# token (default) uses MCP_AUTH_TOKEN or a secret MCP_PATH above. AUTH_MODE=homeassistant still works
# and means AUTH_METHODS=homeassistant
AUTH_MODE=token

# Required when a sign-in method is on: this server's public address, no path
PUBLIC_URL=https://mcp.example.com

# Home Assistant mode (required): Home Assistant's address as the browser sees it, no path
HOME_ASSISTANT_PUBLIC_URL=https://ha.example.com

# Home Assistant mode (required): Home Assistant's address as this server reaches it, no path
HOME_ASSISTANT_URL=http://homeassistant:8123

# Optional, when a sign-in method is on: where oauth.json (registered clients and connections) is kept. Keep private, back up
DATA_DIR=./data

# Optional, when a sign-in method is on: hostnames a login code may be sent to, no scheme or port; only these can
# register as clients. Add localhost,127.0.0.1 for Claude Code
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# OpenID Connect (required when oidc is in AUTH_METHODS): the provider's address. https only; may have a path
# OIDC_ISSUER=https://idp.example.com/realms/home

# OpenID Connect (required when oidc is on): the client id registered at the provider
# OIDC_CLIENT_ID=lubelogger-mcp

# OpenID Connect (optional): the client secret, if the client is confidential
# OIDC_CLIENT_SECRET=

# OpenID Connect (optional): the name on the sign-in button
# OIDC_DISPLAY_NAME=single sign-on

# OpenID Connect (at least one of these three is required when oidc is on): who may sign in.
# An email counts only if the provider marks it verified
# Comma-separated email addresses
# OIDC_ALLOWED_EMAILS=alice@example.com
# Comma-separated subject (sub) values
# OIDC_ALLOWED_SUBJECTS=
# A group the ID token must list in its groups claim
# OIDC_REQUIRED_GROUP=

# OpenID Connect (optional): the ID token claim that lists groups
# OIDC_GROUPS_CLAIM=groups

# OpenID Connect (optional): extra sign-in query parameters. Google issues a refresh token only with these;
# without one a connection ends within about an hour
# OIDC_AUTH_PARAMS=access_type=offline&prompt=consent

# --- LubeLogger sign-in

# Password sign-in (required when lubelogger-password is on): comma-separated LubeLogger usernames that may sign in
# LUBELOGGER_ALLOWED_USERS=alice,bob

# Optional
PORT=3000
HOST=0.0.0.0
CONFIRM_TTL_MINUTES=30
REQUEST_TIMEOUT_MS=15000
